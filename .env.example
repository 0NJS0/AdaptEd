# ============================================================
# AdaptED environment configuration (copy to .env and fill in)
# ============================================================

# --- App ---
APP_NAME=AdaptED
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:8501,http://localhost:8000
STORAGE_DIR=./storage


DATABASE_URL=
# Leave LLM_PROVIDER=mock for a fully offline/deterministic run without keys.
# Set LLM_PROVIDER=openrouter + a valid OPENROUTER_API_KEY for real content.
LLM_PROVIDER=mock
OPENROUTER_BASE_URL=Openrouter API base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=
LLM_MODEL=preferred LLM model
EMBED_MODEL=preferred embedding model

# --- Embeddings ---
# Real embeddings via OpenRouter's free Nemotron embed model (2048-dim,
# query-aware via input_type=passage|query). "mock" is the offline fallback.
EMBED_PROVIDER=mock

# Must match the embedding model's output dimension (pgvector columns are fixed-size).
EMBEDDING_DIM=2048

# --- SearXNG (optional) ---
SEARXNG_URL=
SEARXNG_INSECURE=false

# --- JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
